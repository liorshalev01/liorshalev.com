---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const dateFormat = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<Layout
  title="Blog — Lior Shalev"
  description="Notes on security engineering, low-level systems, and building things that have to keep working."
>
  <h1>Blog</h1>
  <ul class="not-prose space-y-8">
    {
      posts.map((post) => (
        <li>
          <a
            href={`/blog/${post.id}`}
            class="text-xl font-semibold no-underline hover:underline"
          >
            {post.data.title}
          </a>
          <p class="text-sm text-gray-500">
            <time datetime={post.data.publishDate.toISOString()}>
              {dateFormat.format(post.data.publishDate)}
            </time>
          </p>
          <p class="text-gray-700">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Layout>
