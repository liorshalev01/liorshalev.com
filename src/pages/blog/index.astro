---
import Layout from "@/layouts/Layout.astro";
import { getPosts } from "@/lib/blog";
import { formatDate } from "@/lib/date";

const posts = await getPosts();
---

<Layout
  title="Lior Shalev - Blog"
  description="Notes on security engineering, low-level systems, and building things that have to keep working."
>
  <h1>Blog</h1>
  <ul class="not-prose space-y-8">
    {
      posts.map((post) => (
        <li>
          <a
            href={`/blog/${post.id}`}
            class="text-xl font-semibold no-underline hover:underline"
          >
            {post.data.title}
          </a>
          <p class="text-sm text-gray-500">
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
          </p>
          <p class="text-gray-700">{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</Layout>
