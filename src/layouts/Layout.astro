---
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  isHome?: boolean;
}

const { title, description, isHome = false } = Astro.props;
const cleanPath = Astro.url.pathname.replace(/(?:index)?\.html$/, "");
const canonical = new URL(cleanPath, Astro.site).href;
const ogImage = new URL("/assets/lior-shalev.png", Astro.site).href;

const jobTitle = "Software architect and hands-on systems engineer";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/cv", label: "CV" },
  { href: "/blog", label: "Blog" },
];

const socialLinks = [
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/liorshalev",
    icon: "/assets/linkedin.png",
  },
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Lior Shalev",
  jobTitle: jobTitle,
  url: "https://liorshalev.com",
  image: ogImage,
  sameAs: socialLinks.map((link) => link.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Lior Shalev - Blog"
      href="/rss.xml"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lior Shalev" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Lior Shalev" />
    <meta name="twitter:card" content="summary" />
    {
      isHome && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(personSchema)}
        />
      )
    }
  </head>
  <body>
    <div class="flex flex-col gap-8 min-h-screen max-w-prose mx-auto px-8 py-8">
      <header class="print:hidden">
        <nav class="flex flex-row gap-6 text-sm">
          {
            navLinks.map((link) => {
              const active =
                cleanPath === link.href ||
                (link.href !== "/" && cleanPath.startsWith(link.href));
              return (
                <a
                  href={link.href}
                  class={
                    active
                      ? "font-semibold underline"
                      : "text-gray-600 no-underline hover:underline"
                  }
                >
                  {link.label}
                </a>
              );
            })
          }
        </nav>
      </header>

      <main class="prose grow">
        <slot />
      </main>

      <footer class="print:hidden flex flex-row items-center py-8">
        <div class="flex items-center gap-4">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                title={social.label}
                target="_blank"
                rel="noopener noreferrer"
              >
                <img src={social.icon} alt={social.label} class="h-5 w-5" />
              </a>
            ))
          }
        </div>
      </footer>
    </div>
  </body>
</html>
