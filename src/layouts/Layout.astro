---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  isHome?: boolean;
}

const { title, description, isHome = false } = Astro.props;
const cleanPath = Astro.url.pathname.replace(/(?:index)?\.html$/, "");
const canonical = new URL(cleanPath, Astro.site).href;
const ogImage = new URL("/assets/lior-shalev.png", Astro.site).href;

const socialLinks = [
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/liorshalev",
    icon: "/assets/linkedin.png",
  },
  {
    label: "GitHub",
    href: "https://github.com/liorshalev01",
    icon: "/assets/github.png",
  },
];

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Lior Shalev",
  jobTitle: "Software architect and hands-on systems engineer",
  url: "https://liorshalev.com",
  image: ogImage,
  sameAs: socialLinks.map((link) => link.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lior Shalev" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Lior Shalev" />
    <meta name="twitter:card" content="summary" />
    {
      isHome && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(personSchema)}
        />
      )
    }
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-9TSHXEV0C3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-9TSHXEV0C3");
    </script>
  </head>
  <body class="flex flex-col min-h-screen max-w-prose mx-auto px-8 py-8 gap-8">
    <header>
      <nav class="flex flex-row gap-6 text-sm font-medium">
        <a href="/" class="no-underline hover:underline">Home</a>
        <a href="/cv" class="no-underline hover:underline">CV</a>
        <a href="/blog" class="no-underline hover:underline">Blog</a>
      </nav>
    </header>
    <main class="prose grow">
      <slot />
    </main>
    <footer>
      <div class="flex items-center gap-4">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              aria-label={link.label}
              title={link.label}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img src={link.icon} alt={link.label} class="h-6 w-auto" />
            </a>
          ))
        }
      </div>
    </footer>
  </body>
</html>
