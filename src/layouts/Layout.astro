---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  isHome?: boolean;
}

const { title, description, isHome = false } = Astro.props;
const cleanPath = Astro.url.pathname.replace(/(?:index)?\.html$/, "");
const canonical = new URL(cleanPath, Astro.site).href;
const ogImage = new URL("/assets/lior-shalev.png", Astro.site).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Lior Shalev",
  jobTitle: "Software architect and hands-on systems engineer",
  url: "https://liorshalev.com",
  image: ogImage,
  sameAs: [
    "https://linkedin.com/in/liorshalev",
    "https://github.com/liorshalev01",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lior Shalev" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Lior Shalev" />
    <meta name="twitter:card" content="summary" />
    {
      isHome && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(personSchema)}
        />
      )
    }
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-9TSHXEV0C3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-9TSHXEV0C3");
    </script>
  </head>
  <body>
    <header class="prose mx-auto px-8 pt-8">
      <nav class="flex gap-6 text-sm font-medium">
        <a href="/" class="no-underline hover:underline">Home</a>
        <a href="/cv" class="no-underline hover:underline">CV</a>
        <a href="/blog" class="no-underline hover:underline">Blog</a>
      </nav>
    </header>
    <slot />
  </body>
</html>
